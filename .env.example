# Deployment configuration. Do not put online provider settings here.
APP_SECRET_KEY=change-me-in-local-or-production
VIDEOSIEVE_API_DATA_DIR=runtime/api
VIDEOSIEVE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# VideoSieve has no in-product login. Keep Web/API on loopback by default.
# Remote access requires an outer trusted boundary such as Tailscale,
# Yukirin Gateway, or an authenticated reverse proxy.

# Online ASR/VLM/summary endpoint, model and credential are configured in the Web UI.
# Provider credentials are encrypted at rest with APP_SECRET_KEY.
#
# Legacy snapshot compatibility only. Leave these unset for a new installation;
# old immutable job snapshots may still reference these credential names.
# CAPSWRITER_TOKEN=
# QWEN_API_KEY=
# SUMMARY_API_KEY=
