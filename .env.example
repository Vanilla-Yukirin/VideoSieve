# Backend
APP_SECRET_KEY=change-me-in-local-or-production
VIDEOSIEVE_API_DATA_DIR=runtime/api
VIDEOSIEVE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_GUEST_MODE=false
GUEST_ALLOW_COOKIE_INPUT=false
GUEST_JOB_COOLDOWN_SECONDS=120
GUEST_COOKIE_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VLM_MODEL=qwen3.5-plus
VLM_TIMEOUT_SECONDS=60
SUMMARY_API_KEY=
SUMMARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
SUMMARY_MODEL=qwen-plus

# Frontend
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# ASR
VIDEOSIEVE_ASR_PROVIDER=unconfigured
VIDEOSIEVE_ASR_ENDPOINT=
VIDEOSIEVE_ASR_LANGUAGE=auto
VIDEOSIEVE_ASR_CONTEXT=
VIDEOSIEVE_ASR_TIMEOUT_SECONDS=900
# Optional. Upstream CapsWriter does not require a token.
CAPSWRITER_TOKEN=
