{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleDirectories": ["node_modules", "<rootDir>/node_modules"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "roots": [
    "<rootDir>",
    "<rootDir>/../../tests/unit"
  ],
  "testMatch": [
    "**/test_web_*.ts",
    "**/test_web_*.tsx"
  ],
  "transform": {
    "^.+\\.tsx?$": "ts-jest"
  }
}

