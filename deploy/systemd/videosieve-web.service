[Unit]
Description=VideoSieve Next.js web
After=videosieve-api.service

[Service]
Type=simple
WorkingDirectory=/home/vanilla/services/videosieve/app/apps/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=VIDEOSIEVE_BIND_HOST=127.0.0.1
ExecStart=/usr/bin/node /home/vanilla/services/videosieve/app/apps/web/node_modules/next/dist/bin/next start --hostname ${VIDEOSIEVE_BIND_HOST} --port 3847
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
